# ==============================================================================
# AWSense Backend Environment Configuration
# Copy this file to .env for local development:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Database (SQLAlchemy)
# ------------------------------------------------------------------------------
# Connection URL (defaults to local SQLite file backend/awsense.db when unset/empty)
DATABASE_URL=sqlite:///./awsense.db

# Example PostgreSQL connection string:
# DATABASE_URL=postgresql+psycopg2://awsense:awsense@localhost:5432/awsense

# Set to "true" to echo generated SQL statements to stdout (default: false)
SQL_ECHO=false

# ------------------------------------------------------------------------------
# Telemetry Ingestion Provider
# ------------------------------------------------------------------------------
# Source mode: "mock" (deterministic offline generator) or "aws" (live boto3 read-only collectors)
DATA_SOURCE=mock

# AWS configuration (used when DATA_SOURCE=aws; Cost Explorer always targets us-east-1)
AWS_REGION=us-east-1
# Optional named AWS CLI/SDK profile; leave blank to use default credential chain / IAM role
AWS_PROFILE=

# ------------------------------------------------------------------------------
# AI Incident Explainer (Optional - leave keys blank for deterministic template fallback)
# ------------------------------------------------------------------------------
# Provider precedence: OPENAI_API_KEY -> LLM_API_KEY -> GEMINI_API_KEY -> deterministic template
OPENAI_API_KEY=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
