# ==============================================================================
# AWSense Frontend Environment Configuration
# Copy this file to .env or pass inline on the command line:
#   VITE_USE_MOCK=false npm run dev
# ==============================================================================

# Telemetry data mode:
#   VITE_USE_MOCK=true   -> Offline sample-data mode using local fixtures in src/mock/
#                           (badge shows "Sample data"; no backend server required)
#   VITE_USE_MOCK=false  -> Live backend mode calling the FastAPI API at VITE_API_URL
#                           (badge shows "Live data"; requires uvicorn backend running)
VITE_USE_MOCK=true

# Backend REST API base URL (must include the /api/v1 prefix).
# During `npm run dev`, Vite proxies /api requests targeting http://localhost:8000/api/v1.
VITE_API_URL=http://localhost:8000/api/v1
